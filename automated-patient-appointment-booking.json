        "jsCode": "const tz = 'Africa/Lagos';\nconst date = $json.date;   // YYYY-MM-DD\nconst time = $json.time;   // HH:mm\nconst dur = parseInt($json.durationMin || 30, 10);\n\nconst startLocal = `${date}T${time}:00`;\nconst start = new Date(startLocal); // n8n uses server TZ; if needed, adjust with luxon/moment in Code node, otherwise keep simple\nconst end = new Date(start.getTime() + dur * 60000);\n\nconst pad = n => String(n).padStart(2, '0');\nconst iso = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:00`;\n\nreturn [{\n  json: {\n    ...$json,\n    startIso: iso(start),\n    endIso: iso(end),\n    slotMinutes: dur,\n    tz\n  }\n}];\n"
      },
