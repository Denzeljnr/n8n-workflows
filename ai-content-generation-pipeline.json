    {
      "parameters": {
        "jsCode": "// Extract the AI response\nconst aiResponse = $input.first().json.output;\n\n// Parse the JSON\nlet captions;\ntry {\n  // Remove any markdown formatting if present\n  const cleanResponse = aiResponse.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  captions = JSON.parse(cleanResponse);\n} catch (error) {\n  throw new Error(\"Gemini did not return valid JSON: \" + aiResponse);\n}\n\n// Return structured data\nreturn [{\n  json: {\n    user_name: $('Extract & Clean Form Data').first().json.user_name,\n    user_email: $('Extract & Clean Form Data').first().json.user_email,\n    content_topic: $('Extract & Clean Form Data').first().json.content_topic,\n    caption_professional: captions.professional,\n    caption_conversational: captions.conversational,\n    caption_inspirational: captions.inspirational\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
