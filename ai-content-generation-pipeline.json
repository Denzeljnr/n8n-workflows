    {
      "parameters": {
        "jsCode": "// Get data from different nodes\nconst formData = $('Extract & Clean Form Data').first().json;\nconst captionData = $('Parse Caption Response').first().json;\nconst driveData = $('Upload file').first().json; // Get Google Drive upload data\nconst unsplashData = $('Generate Image - Unsplash').first().json;\n\n// Get photographer info from Unsplash response\nconst photographerName = $('Generate Image - Unsplash').first().json.user.name;\nconst photographerUrl = $('Generate Image - Unsplash').first().json.user.links.html;\n\n// Get Google Drive link\nconst driveLink = driveData.webViewLink;\n\nconst emailHTML = `\n<div style=\"font-family: Arial, sans-serif; max-width: 700px; margin: 0 auto; padding: 20px;\">\n  \n  <h1 style=\"color: #0a66c2; border-bottom: 3px solid #0a66c2; padding-bottom: 10px;\">\n    🎯 Your AI-Generated LinkedIn Content is Ready!\n  </h1>\n  \n  <p style=\"font-size: 16px; color: #333;\">Hi ${formData.user_name},</p>\n  \n  <p style=\"font-size: 14px; color: #666;\">Your content for \"<strong>${formData.content_topic}</strong>\" has been generated. Choose your favorite caption style below:</p>\n  \n  <hr style=\"border: 1px solid #e0e0e0; margin: 30px 0;\">\n  \n  <div style=\"margin-bottom: 30px;\">\n    <h2 style=\"color: #0a66c2; font-size: 18px;\">📊 Professional & Authoritative</h2>\n    <div style=\"background-color: #f3f6f9; padding: 15px; border-radius: 8px; border-left: 4px solid #0a66c2;\">\n      <p style=\"white-space: pre-wrap; line-height: 1.6; color: #333;\">${captionData.caption_professional}</p>\n    </div>\n  </div>\n  \n  <div style=\"margin-bottom: 30px;\">\n    <h2 style=\"color: #28a745; font-size: 18px;\">💬 Conversational & Friendly</h2>\n    <div style=\"background-color: #f0f9f4; padding: 15px; border-radius: 8px; border-left: 4px solid #28a745;\">\n      <p style=\"white-space: pre-wrap; line-height: 1.6; color: #333;\">${captionData.caption_conversational}</p>\n    </div>\n  </div>\n  \n  <div style=\"margin-bottom: 30px;\">\n    <h2 style=\"color: #ff6b35; font-size: 18px;\">✨ Inspirational & Motivational</h2>\n    <div style=\"background-color: #fff5f0; padding: 15px; border-radius: 8px; border-left: 4px solid #ff6b35;\">\n      <p style=\"white-space: pre-wrap; line-height: 1.6; color: #333;\">${captionData.caption_inspirational}</p>\n    </div>\n  </div>\n  \n  <hr style=\"border: 1px solid #e0e0e0; margin: 30px 0;\">\n  \n  <div style=\"margin-bottom: 30px;\">\n    <h2 style=\"color: #0a66c2; font-size: 18px;\">🖼️ Your Image</h2>\n    <p style=\"font-size: 14px; color: #666;\">Download from Google Drive:</p>\n    <a href=\"${driveLink}\" style=\"display: inline-block; background-color: #0a66c2; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 10px;\">📥 Download Image</a>\n    \n    <div style=\"margin-top: 15px; padding: 10px; background-color: #f5f5f5; border-radius: 4px; font-size: 12px; color: #666;\">\n      📸 Photo by <a href=\"${photographerUrl}?utm_source=AI_Content_Generator&utm_medium=referral\" style=\"color: #0a66c2; text-decoration: none;\">${photographerName}</a> on <a href=\"https://unsplash.com?utm_source=AI_Content_Generator&utm_medium=referral\" style=\"color: #0a66c2; text-decoration: none;\">Unsplash</a>\n    </div>\n  </div>\n  \n  <hr style=\"border: 1px solid #e0e0e0; margin: 30px 0;\">\n  \n  <div style=\"background-color: #fff9e6; padding: 15px; border-radius: 8px; border-left: 4px solid #ffc107;\">\n    <h3 style=\"color: #f57c00; margin-top: 0;\">💡 Pro Tips:</h3>\n    <ul style=\"color: #666; line-height: 1.8;\">\n      <li>Test different captions to see what resonates with your audience</li>\n      <li>Post at optimal times (Tue-Thu, 8-10am or 12-1pm)</li>\n      <li>Engage with comments within the first hour for better reach</li>\n      <li>Add relevant hashtags (3-5 max)</li>\n      <li><strong>Credit the photographer when you post!</strong></li>\n    </ul>\n  </div>\n  \n  <p style=\"color: #999; font-size: 12px; margin-top: 40px; text-align: center;\">\n    Generated by AI Social Media Content Generator\n  </p>\n  \n</div>\n`;\n\nreturn [{\n  json: {\n    user_email: formData.user_email,\n    user_name: formData.user_name,\n    content_topic: formData.content_topic,\n    email_html: emailHTML,\n    email_subject: `✅ Your LinkedIn Content: \"${formData.content_topic}\"`\n  }\n}];"
      },
