    {
      "parameters": {
        "jsCode": "const question = $('Form trigger 1').first().json.Question;\n\nconst candidates = $input.all().map((item, i) => ({\n  index: i,\n  text: item.json.document?.pageContent,\n  sourceDocument: item.json.document?.metadata?.sourceDocument || 'unknown'\n}));\n\nconst prompt = `Question: ${question}\n\nRate each passage's relevance to the question, 0-10. Respond ONLY with a JSON array of integers, same order as given, no other text.\n\n` + candidates.map(c => `[${c.index}] ${c.text}`).join('\\n');\n\nreturn [{ json: { prompt, candidates, question } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        512,
        704
      ],
      "id": "fc3e82c0-b60b-455b-9d2d-0374699165bf",
      "name": "Format candidates for reranking"
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        720,
        896
      ],
      "id": "a78df6e8-9ecd-4329-a4e9-8a5ff9aa5109",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "i2YJ0xjCu8FLh6F6",
          "name": "website"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "options": {
          "systemMessage": "You are a relevance-scoring assistant for a document search system. You will be given a user's question and a numbered list of text passages retrieved from a vector database. Your only job is to rate how relevant each passage is to answering the question, on a scale of 0 (completely irrelevant) to 10 (directly and completely answers the question).\n\nRules:\n- Score every passage in the list, even if none of them seem relevant to the question.\n- Do not explain your reasoning or add any commentary.\n- Do not include any text other than the JSON array.\n- The array must have exactly the same number of elements, in the same order, as the passages given.\n\nRespond ONLY in this exact format, no other text:\n[7, 2, 9, 0, 5]"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        720,
        704
      ],
      "id": "35fa98c5-de13-4611-9d6e-2d15311b6a0c",
      "name": "Score relevance"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nlet scores;\ntry { scores = JSON.parse(cleaned); } catch { scores = []; }\n\nconst candidates = $('Format candidates for reranking').first().json.candidates;\nconst ranked = candidates\n  .map((c, i) => ({ ...c, relevance: scores[i] ?? 0 }))\n  .sort((a, b) => b.relevance - a.relevance)\n  .slice(0, 5);\n\nreturn [{\n  json: {\n    question: $('Format candidates for reranking').first().json.question,\n    ranked\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        704
      ],
      "id": "3e82eb8a-0138-4005-ae68-29e604e0fb80",
      "name": "Rerank and keep top 5"
    },
    {
      "parameters": {
        "jsCode": "const { question, ranked } = $input.first().json;\n\nconst context = ranked\n  .map(r => `[Source: ${r.sourceDocument}] ${r.text}`)\n  .join('\\n\\n');\n\nconst prompt = `Question: ${question}\n\nPassages:\n${context}`;\n\nreturn [{ json: { question, ranked, answerPrompt: prompt } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        704
      ],
      "id": "fce10d57-5085-4fa7-ac15-82eeafe0a630",
      "name": "Build answer context"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.answerPrompt }}",
        "options": {
          "systemMessage": "You are a research assistant answering questions using only the source passages provided to you. Follow these rules strictly:\n\n1. Only use information contained in the passages below. Do not use any outside knowledge, even if you're confident it's correct.\n2. If the passages don't contain enough information to fully answer the question, say so clearly instead of guessing or filling gaps with assumptions.\n3. After every claim or piece of information in your answer, cite which source document it came from, in square brackets, exactly like this: [Source: filename.pdf]\n4. If multiple passages support the same point, you may cite more than one source.\n5. Keep the answer focused and directly address the question asked — don't pad with unrelated detail from the passages."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1488,
        704
      ],
      "id": "325e29b2-6ae5-4bf2-8883-bffb4d6bedff",
      "name": "Generate answer"
    },
