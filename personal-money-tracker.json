    {
      "parameters": {
        "jsCode": "const allTransactions = $input.all().map(item => item.json);\n\n// Sort by date (newest first) and limit to last 10\nconst sortedTransactions = allTransactions\n  .filter(txn => txn.Transaction_ID) // Skip header row\n  .sort((a, b) => new Date(b.Date) - new Date(a.Date))\n  .slice(0, 10) // Only last 10\n  .map(txn => ({\n    id: txn.Transaction_ID,\n    date: txn.Date,\n    type: txn.Type,\n    amount: parseFloat(txn.Amount || 0),\n    description: txn.Description,\n    runningBalance: parseFloat(txn.Running_Balance || 0)\n  }));\n\nreturn [{\n  json: {\n    transactions: sortedTransactions,\n    count: sortedTransactions.length\n  }\n}];"
      },
