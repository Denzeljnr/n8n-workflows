      "parameters": {
        "jsCode": "const expenseData = $node[\"Validate Input1\"].json;\nconst accountData = $input.first().json;\n\n// Get current balance\nconst currentBalance = parseFloat(accountData.Current_Balance || 0);\nconst expenseAmount = expenseData.amount;\n\n// Calculate new balance (subtract expense)\nconst newBalance = currentBalance - expenseAmount;\n\nconsole.log('Current balance:', currentBalance);\nconsole.log('Expense amount:', expenseAmount);\nconsole.log('New balance:', newBalance);\n\n// Warn if balance goes negative\nif (newBalance < 0) {\n  console.warn('WARNING: Balance is now negative!');\n}\n\nreturn [{\n  json: {\n    ...expenseData,\n    previousBalance: currentBalance,\n    newBalance: newBalance,\n    transactionId: `TXN-${Date.now()}`,\n    isNegative: newBalance < 0\n  }\n}];"
      },
