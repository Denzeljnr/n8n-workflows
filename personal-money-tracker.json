      "parameters": {
        "jsCode": "const incomeData = $node[\"Validate Input\"].json;\nconst accountData = $input.first().json;\n\n// Get current balance (from Google Sheets row 2, column A)\nconst currentBalance = parseFloat(accountData.Current_Balance || 0);\nconst incomeAmount = incomeData.amount;\n\n// Calculate new balance\nconst newBalance = currentBalance + incomeAmount;\n\nconsole.log('Current balance:', currentBalance);\nconsole.log('Income amount:', incomeAmount);\nconsole.log('New balance:', newBalance);\n\nreturn [{\n  json: {\n    ...incomeData,\n    previousBalance: currentBalance,\n    newBalance: newBalance,\n    transactionId: `TXN-${Date.now()}`\n  }\n}];"
      },
