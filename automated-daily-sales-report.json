    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of $input.all()) {\n  item.json.myNewField = 1;\n}\nconst rows = items.map(item => item.json);\n\nlet totalSales = 0;\nlet totalQuantity = 0;\n\nrows.forEach(row => {\n  totalSales += Number(row.Total) || 0;\n  totalQuantity += Number(row.Quantity) || 0;\n});\n\nconst averageSale = totalSales / rows.length || 0;\n\nreturn [{\n  json: {\n    totalSales,\n    totalQuantity,\n    averageSale,\n    reportDate: new Date().toLocaleDateString()\n  }\n}];\n\nreturn $input.all();\n\n\n"
      },
