    {
      "parameters": {
        "jsCode": "// Combine everything from the Merge node into a single item\n\n// Collect data from all merged items\nlet combinedMessageHistory = [];\nlet customerData = {};\nlet currentMessage = \"\";\nlet tone = \"friendly\";\n\n// Loop through all items coming from the Merge node\nfor (const item of $input.all()) {\n  const json = item.json;\n\n  // Merge message history\n  if (json.Message_history && Array.isArray(json.Message_history)) {\n    combinedMessageHistory = combinedMessageHistory.concat(\n      json.Message_history.map(m => ({ role: m.role, content: m.content }))\n    );\n  }\n\n  // Get the latest customer data\n  if (json.customer) {\n    customerData = { ...customerData, ...json.customer };\n  }\n\n  // Use the latest user message if available\n  if (json.body && json.body.message) {\n    currentMessage = json.body.message;\n  }\n\n  // Tone override\n  if (json.body && json.body.tone_override) {\n    tone = json.body.tone_override;\n  } else if (json.customer && json.customer.tone_preference) {\n    tone = json.customer.tone_preference;\n  }\n}\n\n// Return a single item\nreturn [\n  {\n    json: {\n      customer: customerData,\n      tone: $('Edit Fields').first().json.body.tone_override,\n      current_message: currentMessage,\n      Message_history: combinedMessageHistory\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        448
      ],
      "id": "c31c7268-7e47-4f5d-a413-147d43ffea2f",
      "name": "Code1"
